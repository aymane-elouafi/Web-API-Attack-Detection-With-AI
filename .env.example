# Copy to .env (never commit it). docker compose reads it automatically.
WAF_ADMIN_TOKEN=change-me-to-a-long-random-string     # required: gateway admin API + console use it
# CONSOLE_PASSWORD=                                    # optional login for the console (strongly advised if you expose it)
# WAFGW_MODE=monitor                                   # monitor (log only) or block
# WAFGW_CORAZA_URL=http://coraza:8081                  # with: docker compose --profile coraza up
# Host ports (defaults shown). Admin and console are published on 127.0.0.1 only.
# GATEWAY_PORT=8080
# ADMIN_PORT=9000
# CONSOLE_PORT=8100
